# Documentação do código com doxygen. Uso, na raiz:  doxygen
# Saída em build/docs/html/index.html (build/ não vai para o Git).
# Só as opções diferentes do padrão estão aqui.

PROJECT_NAME           = "DroneController"
PROJECT_BRIEF          = "Kalman + LQR do TCC na STM32F411 com BNO08x, MTF-01 e DShot600"
OUTPUT_DIRECTORY       = build/docs
OUTPUT_LANGUAGE        = Brazilian
INPUT_ENCODING         = UTF-8

INPUT                  = README.md \
                         docs \
                         tools/pi/README.md \
                         App/Inc \
                         App/Src
FILE_PATTERNS          = *.h *.c *.md
RECURSIVE              = YES
EXCLUDE                = App/Src/sh2 \
                         docs/references
USE_MDFILE_AS_MAINPAGE = README.md

OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_STATIC         = YES
SOURCE_BROWSER         = YES
MARKDOWN_SUPPORT       = YES
TYPEDEF_HIDES_STRUCT   = NO

QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_NO_PARAMDOC       = NO
WARN_LOGFILE           = build/docs/warnings.log

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO
