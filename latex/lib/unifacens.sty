%% ============================================================================
%% unifacens.sty - Customizações para o Centro Universitário Facens
%% Atualizado em: Março/2026
%% Baseado em: abnTeX2 e Manual de Textos Técnicos MSGQ-21.01 REV.18
%% ============================================================================
%%
%% Este pacote contém customizações específicas do Centro Universitário Facens
%% para trabalhos acadêmicos (TCC, dissertações, etc).
%%
%% PRINCIPAIS FUNCIONALIDADES:
%% - Definição de variáveis institucionais (coordenadoria, integrantes, etc)
%% - Formatação da capa conforme MANUAL MSGQ-21.01 REV.18
%% - Formatação da folha de rosto conforme MANUAL MSGQ-21.01 REV.18
%% - Adequação às normas ABNT NBR 14724:2011
%%
%% CORREÇÕES APLICADAS (validadas contra MANUAL MSGQ-21.01 REV.18):
%% - Logo da capa: ajustado para height=2cm conforme manual (era scale=0.5)
%% - Coordenadoria na capa: ajustado para Arial 16pt (era \Large ≈ 14pt)
%% - Preâmbulo na folha de rosto: fonte corrigida para \normalsize/Arial 12pt (era \small)
%% - Espaçamento do preâmbulo: corrigido para 1,5 / OnehalfSpace (era SingleSpace)
%%
%% ============================================================================

% ============================================================================
% INFORMAÇÕES DO PACOTE
% ============================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{lib/unifacens}[2026/02/27 v2.0 Customizações UniFacens]

