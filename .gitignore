# Saídas de compilação -------------------------------------------------------
# O CubeIDE recria Debug/ e Release/. tools/build.py recria build/.
/Debug/
/Release/
/build/

# Dependências e artefatos locais de Python ---------------------------------
__pycache__/
*.py[cod]
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Ensaios locais -------------------------------------------------------------
# CSVs de telemetria gravados pelo dronectl (tools/pi) na Pi ou no PC.
tools/pi/logs/

# Conversas completas usadas como referência são arquivos locais. Os
# documentos consolidados e revisados continuam em docs/.
/docs/references/*
!/docs/references/README.md
# Transcrições de sessões salvas na raiz (locais, podem conter dados de acesso).
/codigo_fonte_testes.txt
/*-nov4.txt
# Resultados dos ensaios gravados na Pi (os usados no TCC são copiados para docs/).
tools/pi/ensaios/resultados/

# Arquivos temporários de revisão e saídas de bancada -----------------------
/tmp/
/logs/
*.log
*.trace
*.tmp
*.temp
*.bak
*.orig
*.rej
*~

# Configurações locais de IDE e sistema operacional -------------------------
# .project, .cproject, .mxproject e .settings/ são mantidos no Git porque são
# necessários para importar o projeto de forma consistente no CubeIDE. O
# detector de toolchain abaixo contém cache específico da instalação local.
.settings/language.settings.xml
*.launch
.metadata/
.idea/
.vscode/
.vs/
.DS_Store
Thumbs.db
Desktop.ini

# Relatórios intermediários que podem aparecer fora das pastas de build -----
*.o
*.obj
*.d
*.su
*.cyclo
*.gcda
*.gcno
*.gcov

# Logs dos ensaios do painel de controle (tools/controle_gui.py).
# tools/logs/

# Espelhos de terceiros, dados de sessão e builds locais ---------------------
/references/
/hmi/data/
/stm32/build/

# Arquivos de assistentes/IDE de IA não fazem parte do projeto --------------
.claude/
CLAUDE.md
AGENTS.md
.cursor/
.cursorrules
.github/copilot-instructions.md
